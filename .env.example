HOST=127.0.0.1
PORT=37821
BASE_PATH=/codex-web
APP_USERNAME=owner
APP_DISPLAY_NAME=Owner
APP_PASSWORD_HASH=replace-with-bcrypt-hash
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_HOURS=168
PUBLIC_BASE_URL=http://localhost:37821/codex-web
# Keep the real key only in the server-side app.env file. Never commit it.
DASHSCOPE_API_KEY=
# Copy the OpenAI compatible API Host shown on the Model Studio API Key page.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_MODEL=qwen3.5-omni-plus
# Approximate dynamic spelling/topic context budget. Audio tokens are separate.
TRANSCRIPTION_CONTEXT_TOKEN_BUDGET=500
TRANSCRIPTION_CONTEXT_MAX_IMAGES=2
TRANSCRIPTION_CONTEXT_MAX_IMAGE_BYTES=2097152
CODEX_MODEL=
CODEX_WINDOWS_SANDBOX=elevated
PYTHON_VERSION=3.12
PYTHON_RUNTIME_ROOT=

# Host mode (no Docker): run directly on the host as root. Every machine user
# is a tenant, CODEX_HOME points at that user's real ~/.codex, and tasks run
# with the tenant user's own privileges.
# HOST_MODE=true
# In host mode APP_USERNAME must be a real system account (the owner tenant).
# CODEX_TEMPLATE_HOME=/etc/skel/.codex
# When `codex` is not on the root PATH, point at the host CLI explicitly:
# CODEX_RUNTIME_PATH=/home/<user>/.nvm/versions/node/v24.12.0/bin/codex
# Allow web users to opt each conversation into Codex's danger-full-access
# sandbox (skip sandboxing entirely; the agent gets the tenant user's full
# filesystem and shell access). Keep this off unless you trust every user.
# ALLOW_DANGER_FULL_ACCESS=false
# Host mode can also bind 0.0.0.0 for LAN access, but this exposes the login
# form, sessions and uploads on every network interface. Without TLS, passwords
# travel in plaintext; prefer a loopback reverse proxy with HTTPS instead.
# ALLOW_HOST_PUBLIC_BIND=false
